# =============================================================================
#  Store configuration
#  Copy to `.env` and fill in. Every value the business may want to change
#  lives here; no code edits needed. Restart the app after editing.
#  Money values ending in _EGP are whole Egyptian pounds.
# =============================================================================

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
APP_NAME=brand-store
APP_VERSION=0.1.0
# development | production
APP_ENV=development
# Public URL of the site, no trailing slash (used in emails, payment redirects)
BASE_URL=http://localhost:8000
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ----------------------------------------------------------------------------
# Brand
# ----------------------------------------------------------------------------
BRAND_NAME=Maison Nile
BRAND_NAME_AR=ميزون نايل
BRAND_TAGLINE_EN=Everyday pieces, made in Egypt.
BRAND_TAGLINE_AR=قطع يومية، صُنعت في مصر.
# Leave empty to show the brand name as a text logo
BRAND_LOGO_URL=
BRAND_FAVICON_URL=/static/img/favicon.svg
# Accent color (links, badges, focus ring). Hex. Do not use purple.
BRAND_ACCENT_COLOR=#B4532A
BRAND_ACCENT_HOVER_COLOR=#8E3F1E
# Large photo on the home page hero
HERO_IMAGE_URL=https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1200&q=70&fm=webp

# ----------------------------------------------------------------------------
# Contact & social (empty = hidden)
# ----------------------------------------------------------------------------
# International format, digits only, e.g. 201001234567
WHATSAPP_NUMBER=201000000000
WHATSAPP_DEFAULT_MESSAGE=Hi! I have a question about your products.
INSTAGRAM_URL=https://instagram.com/yourbrand
FACEBOOK_URL=
TIKTOK_URL=
SUPPORT_EMAIL=hello@example.com
SUPPORT_PHONE=01000000000

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Local (docker compose): postgresql+asyncpg://store:store@localhost:5432/store
# Supabase: use the *pooler* URL (transaction mode, port 6543)
DATABASE_URL=postgresql+asyncpg://store:store@localhost:5432/store
# Set true when DATABASE_URL points at a transaction-mode pooler (Supabase)
DATABASE_USE_POOLER=false

# ----------------------------------------------------------------------------
# Image storage
# ----------------------------------------------------------------------------
# local = saved under ./media (dev) | supabase = Supabase Storage (production)
STORAGE_BACKEND=local
SUPABASE_URL=
# Service-role key. Server-side only, never exposed to the browser.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=products
# Max long edge of uploaded product photos (px) and WebP quality (1-100)
IMAGE_MAX_SIZE_PX=1600
IMAGE_QUALITY=80

# ----------------------------------------------------------------------------
# Shipping
# ----------------------------------------------------------------------------
# Fee for every governorate not listed in the overrides
SHIPPING_DEFAULT_FEE_EGP=100
# Comma-separated governorate_code:fee pairs. Codes are listed in
# app/utils/governorates.py (e.g. cairo, giza, alexandria, ...)
SHIPPING_FEE_OVERRIDES=alexandria:50
# Shown on product pages, e.g. "Delivery in 2-5 working days"
DELIVERY_DAYS_MIN=2
DELIVERY_DAYS_MAX=5
# Size-exchange window shown on product pages and policies
EXCHANGE_DAYS=14

# ----------------------------------------------------------------------------
# Checkout & cash-on-delivery protection
# ----------------------------------------------------------------------------
COD_ENABLED=true
# Orders above this total cannot use COD (0 = no limit)
COD_MAX_ORDER_EGP=5000
# Max COD orders a phone number may have open (pending/confirmed) at once
COD_MAX_OPEN_ORDERS_PER_PHONE=2
# Max quantity of one item per order line
MAX_QTY_PER_LINE=10
# "Only N left" shown when variant stock is at or below this
LOW_STOCK_THRESHOLD=3
# Unpaid online orders are cancelled (and stock restored) after this many minutes
UNPAID_ORDER_TIMEOUT_MIN=45

# ----------------------------------------------------------------------------
# Paymob (online payments)  https://accept.paymob.com
# ----------------------------------------------------------------------------
PAYMOB_ENABLED=false
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Optional legacy "API Key" (Settings > API Keys). Enables server-side payment
# status checks when a callback is missed. Recommended.
PAYMOB_API_KEY=
# Comma-separated integration IDs from the Paymob dashboard (Apple Pay first)
PAYMOB_INTEGRATION_IDS=
# Egypt: https://accept.paymob.com
PAYMOB_BASE_URL=https://accept.paymob.com
# Label on the checkout radio card
PAYMOB_METHOD_LABEL_EN=Pay online (Apple Pay)
PAYMOB_METHOD_LABEL_AR=الدفع أونلاين (Apple Pay)

# ----------------------------------------------------------------------------
# Bosta (courier)  https://bosta.co
# ----------------------------------------------------------------------------
BOSTA_ENABLED=false
BOSTA_API_KEY=
# Staging: https://stg-app.bosta.co/api/v2 | Production: https://app.bosta.co/api/v2
BOSTA_BASE_URL=https://stg-app.bosta.co/api/v2
# Optional pickup location id from the Bosta dashboard
BOSTA_PICKUP_LOCATION_ID=

# ----------------------------------------------------------------------------
# Telegram alerts for the shop owners
# ----------------------------------------------------------------------------
# Create a bot with @BotFather; get chat ids by messaging the bot then opening
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids (one per owner)
TELEGRAM_CHAT_IDS=

# ----------------------------------------------------------------------------
# Customer emails (order confirmation)
# ----------------------------------------------------------------------------
# none | brevo | resend   (none = emails are only logged)
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=orders@example.com
EMAIL_FROM_NAME=Maison Nile

# ----------------------------------------------------------------------------
# SMS one-time codes for COD (not active yet)
# ----------------------------------------------------------------------------
# none (future: a paid SMS provider)
OTP_PROVIDER=none

# ----------------------------------------------------------------------------
# Security & rate limits  (format: "<count>/<second|minute|hour|day>")
# ----------------------------------------------------------------------------
RATE_LIMIT_CHECKOUT=10/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=60/minute
# Bearer token used by the scheduled cleanup job (GitHub Actions)
INTERNAL_CRON_TOKEN=change-me-too
SESSION_MAX_AGE_DAYS=14

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Optional, free tier at sentry.io
SENTRY_DSN=
