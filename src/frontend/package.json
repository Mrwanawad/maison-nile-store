{
  "name": "brand-store-assets",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i static/css/input.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i static/css/input.css -o static/css/app.css --watch=always",
    "vendor": "node scripts/vendor.mjs",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "htmx.org": "^2.0.11",
    "motion": "^14.0.0",
    "preline": "^4.2.0",
    "tailwindcss": "^4.3.3"
  }
}
